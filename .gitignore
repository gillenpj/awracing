# Pipeline cache — machine-specific and regenerable via `tar_make()`
_targets/

# Written by `tar_config_set()` in the qmd setup chunks on every render;
# contains an absolute path to the store, so machine-specific.
_targets.yaml

# Database credentials
.env

# Interactive R session leftovers — saved by R when a session exits.
# Not used by the pipeline; regenerable.
.RData
.Rhistory

# Quarto's per-project build cache (freeze, idx, xref, session temp).
# Regenerated on render and machine-specific.
.quarto/

# RStudio per-user state (autosaved editor buffers, session history).
# Standard RStudio convention to gitignore the whole directory.
.Rproj.user/

# Claude Code's per-user permission state — machine-specific paths
# and approved-command list. Any future shared project config in
# .claude/settings.json (without `.local`) will still be tracked.
.claude/settings.local.json

# Per-paper Quarto output dir. The rendered HTML / PDF is republished
# into `docs/` for GitHub Pages, so the working copy in `_output/`
# is redundant and regenerable via `tar_make()`.
papers/*/_output/

# Paper-3 GBT artefacts regenerated by _targets.R (model_3_gbt_path,
# model_3_depth1_diag_path, model_3_gridmax_path targets) — build products,
# not source. Note gbt_tuning_final.rds is DELIBERATELY NOT here: it is the
# frozen, committed 72-point tuning-grid result (see CLAUDE.md "Paper 3
# plan"), analogous to renv.lock — a pinned empirical artefact, not a build
# product.
gbt_final_model.xgb
gbt_final_model_meta.rds
gbt_depth1_diagnostic.xgb
gbt_depth1_diagnostic_meta.rds
gbt_gridmax_model.xgb
gbt_gridmax_model_meta.rds

# Paper-3 tuning-grid scratch/resumability files from the standalone
# scripts/run_gbt_tuning.R driver — not consumed by any target (only
# gbt_tuning_final.rds is).
gbt_tuning_checkpoint.csv
gbt_tuning_key.rds
gbt_tuning_divergence*.csv

# Paper-3 pre-drafting diagnostic scratch outputs (scripts/run_results_pass.R,
# scripts/run_diagnostics_pass*.R) — superseded by the gbt_*/ranking_*/
# boot_*/disagreement_* targets in _targets.R.
diag2_item*.rds
diag3_item*.rds
diag3_per_race.rds
diag4_market.rds
results_pass_stage*.rds
results_pass_STOPPED.rds
gbt_gridmax_refit.rds
gbt_race_level_perm.rds

# notes/ is a reference shelf (see CLAUDE.md "Project structure"), not
# consumed by the pipeline. PDFs dropped there (papers being replicated,
# background reading) are deliberately not tracked.
notes/*.pdf

# Session log files from ad hoc tar_make() launches (this project has no
# standing convention of committing render logs) and the incident-diagnosis
# stdout/stderr captures from one-off diagnostic script runs.
tar_make_*.log
*_stdout.log
*_stderr.log
